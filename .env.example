# Copy to .env and fill. Never commit .env (rules.md: placeholders only).
PUBLIC_URL=https://toolkit.example.com
PUBLIC_HOSTNAME=toolkit.example.com
TOOLKIT_SECRET_KEY=          # openssl rand -hex 32
TOOLKIT_OIDC_CLIENT_SECRET=  # from the Keycloak client you create
KC_DB_PASSWORD=              # openssl rand -hex 16
KC_ADMIN=admin
KC_ADMIN_PASSWORD=           # change after first login
KC_SMTP_HOST=
KC_SMTP_PORT=587
KC_SMTP_FROM=accounts@example.com
KC_SMTP_USER=
KC_SMTP_PASSWORD=
