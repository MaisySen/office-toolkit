# Copy to /etc/office-toolkit/ on the host, fill real values, chmod 600.
# Placeholders only: real values never enter git (rules.md).

# --- toolkit.env (office-toolkit.service) ---
TOOLKIT_SECRET_KEY=generate-a-long-random-string
# HTTPS terminates at Caddy, so mark session cookies Secure.
TOOLKIT_SECURE_COOKIES=1
TOOLKIT_AUTH_DB=/var/lib/office-toolkit/auth.db
# Only the production deep link; the Metro dev fallback stays out.
TOOLKIT_MOBILE_REDIRECTS=officetoolkit://auth
TOOLKIT_OIDC_ISSUER=https://doctool.multies.si/auth/realms/office-toolkit
TOOLKIT_OIDC_CLIENT_ID=office-toolkit-web
TOOLKIT_OIDC_CLIENT_SECRET=web-client-secret-from-keycloak

# --- keycloak.env (keycloak.service) ---
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=database-password
KC_HOSTNAME=https://doctool.multies.si/auth
KC_HTTP_RELATIVE_PATH=/auth
KC_HTTP_ENABLED=true
# Caddy's reverse_proxy sends X-Forwarded-* (not RFC 7239 Forwarded),
# so Keycloak must read the xforwarded variant or its redirects come
# out http/loopback.
KC_PROXY_HEADERS=xforwarded
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=bootstrap-admin-password
# Keycloak has no global SMTP env: the sender is configured on the
# office-toolkit realm (smtpServer), same shape the CI seeding script
# uses. Host, port, user, password and from-address come from whichever
# mailbox service the owner approves; see docs/DEPLOYMENT.md.
