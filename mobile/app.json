{
  "expo": {
    "name": "Office Toolkit",
    "slug": "office-toolkit",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "officetoolkit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "au.fintex.officetoolkit",
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)au.fintex.officetoolkit"
        ]
      }
    },
    "android": {
      "package": "au.fintex.officetoolkit"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:5000",
      "oidcIssuer": "http://localhost:8080/realms/office-toolkit",
      "oidcClientId": "office-toolkit-mobile"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store"
    ]
  }
}
